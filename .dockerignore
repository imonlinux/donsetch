# Docker ignore patterns for DonSeTch

# Git
.git
.gitignore
.gitattributes

# CI/CD
.github

# Rust
target/
**/target/

# Fuzzing (development-only)
fuzz/

# Benchmarks (development-only), except bench/live.rs: the search bench
# module is compiled into the crate itself (src/search/bench.rs declares
# `#[path = "../../bench/live.rs"] pub mod live;`), so the release build
# cannot read it from the context if it is stripped here.
bench/
!bench/live.rs

# Scripts (development-only)
scripts/

# Assets (not needed for runtime)
assets/

# npm package (installed separately)
npm/

# Documentation (not needed for runtime)
docs/
*.md
!README.md

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker files (don't copy into image)
docker-compose*.yml
.dockerignore
Dockerfile*

# Never send downloaded browser archives or binaries (an older release's
# CloakBrowser, local Chromium builds) to the Docker build context; the image
# only contains DonSeTch itself and an optional system Chromium installation.
cloakbrowser/
**/cloakbrowser-*.tar.gz
**/cloakbrowser-*.zip
**/Chromium.app/
**/chromium-*/chrome
**/chromium-*/chrome.exe

# Development files
*.log
.env.*
!.env.example
